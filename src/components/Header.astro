---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Inici', icon: '🏠' },
  { href: '/rutes', label: 'Rutes', icon: '🥾' },
  { href: '/acampada', label: 'Refugis & Acampada', icon: '🏕️' },
  { href: '/previsio', label: 'Meteo AEMET', icon: '🌤️' },
  { href: '/transport', label: 'Transport TIB', icon: '🚌' },
  { href: '/agrupaments', label: 'Agrupaments', icon: '⚜️' },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo & Branding -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-[#1b4332] text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-105 transition-transform duration-200">
          ⚜️
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold text-stone-900 leading-tight group-hover:text-[#1b4332] transition-colors">
            Portal d'excursions
          </span>
          <span class="text-xs sm:text-sm font-medium text-stone-500">
            per a escoltes a Mallorca
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-xl text-sm font-semibold transition-all duration-150 flex items-center gap-1.5 ${
                isActive
                  ? 'bg-[#1b4332]/10 text-[#1b4332]'
                  : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100'
              }`}
            >
              <span>{item.icon}</span>
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>

      <!-- Search shortcut button on desktop -->
      <div class="hidden sm:flex items-center gap-2">
        <a
          href="/rutes"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-stone-100 hover:bg-[#1b4332] text-stone-700 hover:text-white font-semibold text-xs sm:text-sm transition-all duration-200 border border-stone-200 hover:border-[#1b4332]"
        >
          <span>🔍 Explorar rutes</span>
        </a>
      </div>

    </div>
  </div>
</header>
