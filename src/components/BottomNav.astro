---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Inici', icon: '🏠' },
  { href: '/rutes', label: 'Rutes', icon: '🥾' },
  { href: '/acampada', label: 'Refugis', icon: '🏕️' },
  { href: '/transport', label: 'Transport', icon: '🚌' },
  { href: '/agrupaments', label: 'Agrupaments', icon: '⚜️' },
];
---

<!-- Fixed Bottom Navigation Bar for Mobile (MD:hidden) -->
<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-stone-200 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] pb-safe">
  <div class="grid grid-cols-5 h-16 max-w-lg mx-auto">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`flex flex-col items-center justify-center min-h-[48px] px-1 py-1 transition-all duration-150 ${
            isActive
              ? 'text-[#1b4332] font-bold'
              : 'text-stone-500 hover:text-stone-900 font-medium'
          }`}
        >
          <span class="text-xl leading-none mb-1">{item.icon}</span>
          <span class="text-[11px] leading-tight truncate w-full text-center">{item.label}</span>
          {isActive && (
            <span class="w-1.5 h-1.5 rounded-full bg-[#1b4332] mt-0.5"></span>
          )}
        </a>
      );
    })}
  </div>
</nav>
