---
import Layout from '../layouts/Layout.astro';
import RouteCard from '../components/RouteCard.astro';
import FilterBar from '../components/FilterBar.astro';

import routes from '../../data/rutes_mallorca.json';
import acampades from '../../data/acampada_mallorca.json';
import experiencies from '../../data/experiencies_rutes.json';

// Get unique zones
const zones = [...new Set(routes.map((r) => r.zona).filter(Boolean))].sort();

// Count experiences per route
const expCounts: Record<string, number> = {};
experiencies.forEach((e) => {
  expCounts[e.ruta_slug] = (expCounts[e.ruta_slug] || 0) + 1;
});
---

<Layout title="Portal d'excursions per a escoltes a Mallorca">
  
  <!-- Hero Section -->
  <section class="relative rounded-3xl bg-gradient-to-br from-[#1b4332] via-[#2d6a4f] to-[#1b4332] text-white p-6 sm:p-10 lg:p-12 mb-10 shadow-xl overflow-hidden">
    <!-- Decorative background glow -->
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-400/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-teal-400/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs sm:text-sm font-semibold mb-4 text-emerald-200">
        <span>⚜️</span>
        <span>Guia per a caps i agrupaments escoltes</span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight mb-4 text-white">
        Portal d'excursions per a escoltes a Mallorca
      </h1>

      <p class="text-sm sm:text-base lg:text-lg text-emerald-100/90 leading-relaxed mb-6 font-normal">
        Troba la millor ruta per a la teva unitat: des de <strong>Ferrerets</strong> (6-8 anys) fins a <strong>Rutes i guies</strong> (17-19 anys). Amb traçats GPS, punts d'aigua revisats i transport públic TIB.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="#cercador-rutes"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white text-[#1b4332] hover:bg-emerald-50 active:bg-emerald-100 font-bold text-xs sm:text-sm shadow-md transition-all"
        >
          <span>🥾 Explorar 65+ rutes</span>
          <span>↓</span>
        </a>

        <a
          href="/acampada"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 active:bg-white/30 backdrop-blur-md border border-white/25 text-white font-bold text-xs sm:text-sm transition-all"
        >
          <span>🏕️ Refugis & Acampada</span>
        </a>

        <a
          href="/transport"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 active:bg-white/30 backdrop-blur-md border border-white/25 text-white font-bold text-xs sm:text-sm transition-all"
        >
          <span>🚌 Transport TIB</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Category Grid -->
  <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 mb-12">
    <a
      href="/rutes"
      class="p-5 rounded-2xl bg-white border border-stone-200 hover:border-[#1b4332]/40 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group"
    >
      <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">🥾</div>
      <div>
        <h3 class="text-sm sm:text-base font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors">65+ Rutes</h3>
        <p class="text-xs text-stone-500 mt-0.5">Adaptades per edats</p>
      </div>
    </a>

    <a
      href="/acampada"
      class="p-5 rounded-2xl bg-white border border-stone-200 hover:border-[#1b4332]/40 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group"
    >
      <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">🏕️</div>
      <div>
        <h3 class="text-sm sm:text-base font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors">{acampades.length} Acampades</h3>
        <p class="text-xs text-stone-500 mt-0.5">Refugis públics i privats</p>
      </div>
    </a>

    <a
      href="/previsio"
      class="p-5 rounded-2xl bg-white border border-stone-200 hover:border-amber-500/50 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group"
    >
      <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">🌤️</div>
      <div>
        <h3 class="text-sm sm:text-base font-bold text-stone-900 group-hover:text-amber-700 transition-colors">Meteo AEMET</h3>
        <p class="text-xs text-stone-500 mt-0.5">53 municipis de Mallorca</p>
      </div>
    </a>

    <a
      href="/transport"
      class="p-5 rounded-2xl bg-white border border-stone-200 hover:border-[#1b4332]/40 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group"
    >
      <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">🚌</div>
      <div>
        <h3 class="text-sm sm:text-base font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors">Bus TIB & Tren</h3>
        <p class="text-xs text-stone-500 mt-0.5">Transport públic a ruta</p>
      </div>
    </a>

    <a
      href="/agrupaments"
      class="p-5 rounded-2xl bg-white border border-stone-200 hover:border-[#1b4332]/40 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group"
    >
      <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">⚜️</div>
      <div>
        <h3 class="text-sm sm:text-base font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors">Agrupaments</h3>
        <p class="text-xs text-stone-500 mt-0.5">Palma i Part Forana</p>
      </div>
    </a>
  </section>

  <!-- Interactive Search and Explorer (Spacious 2-column grid) -->
  <section class="mb-14">
    <FilterBar zones={zones} totalRoutes={routes.length} />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="routesGrid">
      {routes.map((route) => (
        <RouteCard route={route} experienceCount={expCounts[route.slug] || 0} />
      ))}
    </div>
  </section>

  <!-- Enllaços d'Interès Oficials i Escoltisme -->
  <section class="mb-12 bg-white rounded-3xl border border-stone-200 p-6 sm:p-8 shadow-xs">
    <div class="max-w-3xl mb-6">
      <h2 class="text-xl sm:text-2xl font-extrabold text-stone-900 flex items-center gap-2">
        <span>🔗 Enllaços d'interès</span>
      </h2>
      <p class="text-xs sm:text-sm text-stone-600 mt-1">
        Portals oficials del moviment escolta, medi ambient i institucions públiques de Mallorca per a la planificació d'activitats.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <a
        href="https://megm.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-2xl border border-stone-200 hover:border-[#1b4332] bg-stone-50/50 hover:bg-emerald-50/30 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-2xl">⚜️</span>
            <span class="text-xs font-bold text-[#1b4332] group-hover:translate-x-0.5 transition-transform">Visitar ↗</span>
          </div>
          <h3 class="text-sm font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors mb-1">
            Moviment Escolta (MEGM)
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Moviment Escolta i Guiatge de Mallorca: federació d'agrupaments, formació de caps i recursos educatius.
          </p>
        </div>
        <span class="text-[11px] font-semibold text-stone-400 mt-3 pt-2 border-t border-stone-200/60">megm.org</span>
      </a>

      <a
        href="https://caminsdepedra.conselldemallorca.cat/"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-2xl border border-stone-200 hover:border-[#1b4332] bg-stone-50/50 hover:bg-emerald-50/30 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-2xl">🏛️</span>
            <span class="text-xs font-bold text-[#1b4332] group-hover:translate-x-0.5 transition-transform">Visitar ↗</span>
          </div>
          <h3 class="text-sm font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors mb-1">
            Consell de Mallorca · Senderisme
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Portal oficial de Camins de Mallorca: etapes de la Ruta de Pedra en Sec (GR-221), GR-222 i estat dels camins.
          </p>
        </div>
        <span class="text-[11px] font-semibold text-stone-400 mt-3 pt-2 border-t border-stone-200/60">caminsdepedra.conselldemallorca.cat</span>
      </a>

      <a
        href="https://caminsdemallorca.consell-mallorca.cat/ca/reserva-de-refugis"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-2xl border border-stone-200 hover:border-[#1b4332] bg-stone-50/50 hover:bg-emerald-50/30 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-2xl">🏠</span>
            <span class="text-xs font-bold text-[#1b4332] group-hover:translate-x-0.5 transition-transform">Visitar ↗</span>
          </div>
          <h3 class="text-sm font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors mb-1">
            Reserva Refugis del Consell
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Plataforma oficial de reserves de places i menjador als refugis de muntanya de la xarxa insular.
          </p>
        </div>
        <span class="text-[11px] font-semibold text-stone-400 mt-3 pt-2 border-t border-stone-200/60">consell-mallorca.cat</span>
      </a>

      <a
        href="https://ibanat.caib.es/"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-2xl border border-stone-200 hover:border-[#1b4332] bg-stone-50/50 hover:bg-emerald-50/30 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-2xl">🔥</span>
            <span class="text-xs font-bold text-[#1b4332] group-hover:translate-x-0.5 transition-transform">Visitar ↗</span>
          </div>
          <h3 class="text-sm font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors mb-1">
            IBANAT · Espais Naturals
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Institut Balear de la Natura: avisos d'incendis, autoritzacions d'acampada i gestió de finques públiques.
          </p>
        </div>
        <span class="text-[11px] font-semibold text-stone-400 mt-3 pt-2 border-t border-stone-200/60">ibanat.caib.es</span>
      </a>

      <a
        href="https://www.tib.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-2xl border border-stone-200 hover:border-[#1b4332] bg-stone-50/50 hover:bg-emerald-50/30 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-2xl">🚌</span>
            <span class="text-xs font-bold text-[#1b4332] group-hover:translate-x-0.5 transition-transform">Visitar ↗</span>
          </div>
          <h3 class="text-sm font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors mb-1">
            TIB · Transports de Mallorca
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Línies d'autobús interurbà i tren SFM per planificar desplaçaments sostenibles d'unitats escoltes.
          </p>
        </div>
        <span class="text-[11px] font-semibold text-stone-400 mt-3 pt-2 border-t border-stone-200/60">tib.org</span>
      </a>

      <a
        href="https://www.aemet.es/ca/eltiempo/prediccion/municipios"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-2xl border border-stone-200 hover:border-[#1b4332] bg-stone-50/50 hover:bg-emerald-50/30 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-2xl">🌤️</span>
            <span class="text-xs font-bold text-[#1b4332] group-hover:translate-x-0.5 transition-transform">Visitar ↗</span>
          </div>
          <h3 class="text-sm font-bold text-stone-900 group-hover:text-[#1b4332] transition-colors mb-1">
            AEMET · Previsió Oficial
          </h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Predicció meteorològica oficial, alertes meteorològiques (Meteoalerta) i índex de radiació UV.
          </p>
        </div>
        <span class="text-[11px] font-semibold text-stone-400 mt-3 pt-2 border-t border-stone-200/60">aemet.es</span>
      </a>
    </div>
  </section>

</Layout>
