---
import Layout from '../../layouts/Layout.astro';
import transportData from '../../../data/transport_mallorca.json';

const buses = transportData.linies_bus || [];
const trens = transportData.linies_tren || [];
---

<Layout
  title="Transport Públic per a Escoltes a Mallorca - Bus TIB i Tren"
  description="Guia pràctica de línies d'autobús TIB i trens SFM per arribar a les rutes de Mallorca amb agrupaments escoltes."
>
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs text-stone-500 mb-2">
      <a href="/" class="hover:underline">Inici</a>
      <span>›</span>
      <span class="text-stone-800 font-semibold">Transport Públic</span>
    </div>

    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-stone-900 mb-3">
      🚌 Transport Públic per a Sortides Escoltes
    </h1>
    <p class="text-sm sm:text-base text-stone-600 max-w-3xl leading-relaxed">
      A Mallorca, el transport col·lectiu permet reduir la petjada ecològica i fer excursions de travessa (inici en un punt i final en un altre) sense necessitat de cotxes privats.
    </p>
  </div>

  <!-- Group Travel Protocol Alert -->
  <div class="bg-sky-50 border-l-4 border-sky-600 rounded-r-xl p-5 mb-8 text-sky-950 shadow-xs">
    <h3 class="font-bold text-sm sm:text-base mb-1 flex items-center gap-2">
      <span>ℹ️ Avís per a desplaçaments en grup escolta (&gt; 10 persones)</span>
    </h3>
    <p class="text-xs sm:text-sm text-sky-900 leading-relaxed mb-3">
      Si viatgeu amb una unitat nombrosa (Llops, Ràngers, Pioners o tot l'agrupament) en línies d'autobús TIB amb alta afluència a la Serra de Tramuntana (ex: línia 204 Sóller, 231 Valldemossa o 311 Lluc), es recomana contactar prèviament amb el Consorci de Transports de Mallorca (CTM) al telèfon <strong>971 17 77 77</strong> o mitjançant el formulari web per preveure reforços de comboi.
    </p>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <a
        href="https://www.tib.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-sky-700 hover:bg-sky-800 text-white font-bold transition"
      >
        <span>Web oficial de TIB.org</span>
        <span>↗</span>
      </a>
      <a
        href="tel:971177777"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-white border border-sky-200 text-sky-900 font-bold hover:bg-sky-100 transition"
      >
        <span>📞 Trucar al 971 17 77 77</span>
      </a>
    </div>
  </div>

  <!-- Train SFM Section -->
  <section class="mb-12">
    <h2 class="text-xl sm:text-2xl font-bold text-stone-900 mb-4 flex items-center gap-2">
      <span>🚆 Xarxa Ferroviària (SFM & Tren de Sóller)</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {trens.map((t: any) => (
        <div class="bg-white rounded-2xl border border-stone-200 p-5 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800">
                Línia {t.codi}
              </span>
              <a
                href={t.link_horaris}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-sky-600 hover:underline font-bold"
              >
                Horaris ↗
              </a>
            </div>
            <h3 class="text-base font-bold text-stone-900 mb-2">{t.nom}</h3>
            <div class="text-xs text-stone-600 space-y-1 mb-4">
              <p><strong>Estacions clau:</strong> {t.estacions_clau?.join(' · ')}</p>
              <p><strong>Freqüència cap de setmana:</strong> {t.frequencia_cap_de_setmana}</p>
            </div>
          </div>
          <span class="text-[11px] text-stone-500 bg-stone-50 p-2 rounded-lg border border-stone-100">
            Ideal per a rutes al Raiguer i connexions amb bus comarcal.
          </span>
        </div>
      ))}
    </div>
  </section>

  <!-- Bus TIB Section -->
  <section class="mb-12">
    <h2 class="text-xl sm:text-2xl font-bold text-stone-900 mb-4 flex items-center gap-2">
      <span>🚌 Línies d'Autobús TIB cap a Inici de Rutes</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {buses.map((b: any) => (
        <div class="bg-white rounded-2xl border border-stone-200 p-5 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#1b4332]/10 text-[#1b4332]">
                Línia {b.linia}
              </span>
              <a
                href={b.link_horaris}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-sky-600 hover:underline font-bold"
              >
                Horaris TIB ↗
              </a>
            </div>
            <h3 class="text-base font-bold text-stone-900 mb-2">{b.nom}</h3>
            <div class="text-xs text-stone-600 space-y-1 mb-4">
              <p><strong>Recorregut:</strong> {b.recorregut}</p>
              <p><strong>Municipis:</strong> {b.municipis_coberts?.join(', ')}</p>
              <p><strong>Cap de setmana:</strong> {b.frequencia_cap_de_setmana}</p>
            </div>
          </div>
          {b.adequat_escoltes && (
            <span class="text-[11px] font-semibold text-emerald-800 bg-emerald-50 px-2.5 py-1.5 rounded-lg border border-emerald-100 flex items-center gap-1.5">
              <span>⚜️</span>
              <span>Molt recomanat per a unitats escoltes</span>
            </span>
          )}
        </div>
      ))}
    </div>
  </section>
</Layout>
