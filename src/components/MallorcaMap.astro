---
interface Props {
  initialType?: 'all' | 'rutes' | 'acampada';
  heightClass?: string;
}

const { initialType = 'all', heightClass = 'h-[460px] sm:h-[540px]' } = Astro.props;

import { getAllRoutes } from '../data/routes';
import { getAllCampsites } from '../data/campsites';
import { ISLANDS, ARCHIPELAGO_CENTER, ARCHIPELAGO_ZOOM } from '../data/islands';

const routes = getAllRoutes();
const acampades = getAllCampsites();

// Minimal payloads for the map to keep DOM lightweight
const routesGeo = routes.map((r) => ({
  type: 'ruta',
  nom: r.nom,
  slug: r.slug,
  lat: r.lat,
  lon: r.lon,
  municipi: r.municipi,
  zona: r.zona,
  illa: r.illa || 'Mallorca',
  dificultat: r.dificultat,
  distancia_km: r.distancia_km,
  desnivell_positiu_m: r.desnivell_positiu_m,
  apte_unitats: r.apte_unitats || [],
}));

const acampadesGeo = acampades.map((a) => ({
  type: 'acampada',
  nom: a.nom,
  lat: a.lat,
  lon: a.lon,
  municipi: a.municipi,
  illa: a.illa || 'Mallorca',
  titularitat: a.titularitat,
  capacitat: a.capacitat,
  web: a.web,
}));
---

<div class="bg-white rounded-3xl border border-stone-200 shadow-xs overflow-hidden mb-8" id="osmMapWrapper">
  <!-- Map Header & Control Bar -->
  <div class="p-4 sm:p-5 border-b border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-stone-50/60">
    <div>
      <h3 class="text-base sm:text-lg font-bold text-stone-900 flex items-center gap-2">
        <span>🗺️ Mapa interactiu de les Illes Balears</span>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-[#1b4332] border border-emerald-200">
          OpenStreetMap
        </span>
      </h3>
      <p class="text-xs text-stone-500 mt-0.5">
        Visualitza la distribució geogràfica de les excursions i espais d'acampada a Mallorca, Menorca, Eivissa i Formentera.
      </p>
    </div>

    <!-- Map Filter Pills -->
    <div class="flex items-center gap-1.5 bg-stone-200/70 p-1 rounded-xl self-start sm:self-auto text-xs font-bold">
      <button
        type="button"
        class="map-filter-btn px-3 py-1.5 rounded-lg transition"
        data-filter="all"
      >
        Tots ({routes.length + acampades.length})
      </button>
      <button
        type="button"
        class="map-filter-btn px-3 py-1.5 rounded-lg transition"
        data-filter="rutes"
      >
        🥾 Rutes ({routes.length})
      </button>
      <button
        type="button"
        class="map-filter-btn px-3 py-1.5 rounded-lg transition"
        data-filter="acampada"
      >
        🏕️ Refugis & Acampada ({acampades.length})
      </button>
    </div>
  </div>

  <!-- Leaflet Map Container -->
  <div
    id="osmGeneralMap"
    class={`w-full ${heightClass} z-10`}
    data-routes={JSON.stringify(routesGeo)}
    data-acampades={JSON.stringify(acampadesGeo)}
    data-initial-type={initialType}
    data-archipelago-center={JSON.stringify(ARCHIPELAGO_CENTER)}
    data-archipelago-zoom={ARCHIPELAGO_ZOOM}
    data-islands={JSON.stringify(ISLANDS)}
  ></div>

  <!-- Map Filter Active Notice Banner (shown when a filter from map is active) -->
  <div id="mapActiveFilterBar" class="hidden px-5 py-2.5 bg-emerald-50 border-t border-emerald-200 flex items-center justify-between text-xs text-[#1b4332]">
    <div class="flex items-center gap-2">
      <span>📍 Filtre actiu des del mapa:</span>
      <strong id="mapFilterName" class="font-bold underline text-stone-900"></strong>
      <span class="text-stone-500">(la llista inferior s'ha actualitzat)</span>
    </div>
    <button
      type="button"
      id="btnClearMapFilter"
      class="px-2.5 py-1 rounded-md bg-white border border-emerald-300 hover:bg-emerald-100 font-bold text-xs text-[#1b4332] transition"
    >
      Netejar filtre ✕
    </button>
  </div>

  <!-- Map Legend Footer -->
  <div class="px-5 py-3 bg-white border-t border-stone-100 flex items-center justify-between flex-wrap gap-3 text-xs text-stone-600">
    <div class="flex items-center gap-4 flex-wrap font-medium">
      <span class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded-full bg-[#1b4332] inline-block shadow-xs border border-white"></span>
        <strong>Ruta escolta (inici)</strong>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="w-3.5 h-3.5 rounded-full bg-[#d97706] inline-block shadow-xs border border-white"></span>
        <strong>Zona acampada / Refugi</strong>
      </span>
      <span class="hidden md:inline text-stone-400">|</span>
      <span class="text-[#1b4332] font-semibold flex items-center gap-1">
        💡 Clica sobre un punt per filtrar la llista pel seu municipi o paratge
      </span>
    </div>

    <button
      type="button"
      id="btnResetMapZoom"
      class="text-[11px] font-bold text-stone-500 hover:text-stone-900 hover:underline"
    >
      ↺ Centra Illes Balears
    </button>
  </div>
</div>

<script>
  let pendingMapIsland: string | null = null;
  (window as any).__setMapIsland = function(island: string) {
    pendingMapIsland = island;
  };

  function setupOsmMap() {
    const mapEl = document.getElementById('osmGeneralMap');
    if (!mapEl || !(window as any).L) return;

    // Prevent re-initialization if already loaded on this element
    if ((mapEl as any)._leaflet_id) {
      return;
    }

    const L = (window as any).L;
    const routesData = JSON.parse(mapEl.dataset.routes || '[]');
    const acampadesData = JSON.parse(mapEl.dataset.acampades || '[]');
    const initialType = mapEl.dataset.initialType || 'all';

    // Center of Balearic archipelago
    const archipelagoCenter: [number, number] = [39.50, 3.00];
    const archipelagoZoom: number = 8;

    const islandsConfig: Record<string, { center: [number, number]; zoom: number; bounds: [[number, number], [number, number]] }> = {
      mallorca: {
        center: [39.6953, 2.95],
        zoom: 9,
        bounds: [[39.25, 2.30], [39.95, 3.50]],
      },
      menorca: {
        center: [39.95, 4.10],
        zoom: 10,
        bounds: [[39.75, 3.75], [40.10, 4.35]],
      },
      eivissa: {
        center: [38.98, 1.40],
        zoom: 10,
        bounds: [[38.80, 1.15], [39.15, 1.65]],
      },
      formentera: {
        center: [38.70, 1.45],
        zoom: 11,
        bounds: [[38.60, 1.35], [38.80, 1.60]],
      },
    };

    const map = L.map('osmGeneralMap', {
      center: archipelagoCenter,
      zoom: archipelagoZoom,
      scrollWheelZoom: false,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(map);

    // Custom circular pulse markers for clean design
    const routeIcon = L.divIcon({
      className: 'osm-custom-pin-route',
      html: `<div style="background-color: #1b4332; width: 22px; height: 22px; border-radius: 50%; border: 2.5px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; font-size: 11px; color: white;">🥾</div>`,
      iconSize: [22, 22],
      iconAnchor: [11, 11],
      popupAnchor: [0, -11],
    });

    const acampadaIcon = L.divIcon({
      className: 'osm-custom-pin-camp',
      html: `<div style="background-color: #d97706; width: 22px; height: 22px; border-radius: 50%; border: 2.5px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; font-size: 11px; color: white;">🏕️</div>`,
      iconSize: [22, 22],
      iconAnchor: [11, 11],
      popupAnchor: [0, -11],
    });

    const routeMarkers: any[] = [];
    const acampadaMarkers: any[] = [];

    // Helper to trigger list filtering below from map
    function triggerFilterFromMap(keyword: string, type: 'municipi' | 'zona' | 'nom') {
      const searchInputRoutes = document.getElementById('searchInput') as HTMLInputElement | null;
      const searchInputCamps = document.getElementById('searchAcampada') as HTMLInputElement | null;

      const activeBar = document.getElementById('mapActiveFilterBar');
      const filterNameEl = document.getElementById('mapFilterName');

      if (activeBar && filterNameEl) {
        activeBar.classList.remove('hidden');
        filterNameEl.textContent = keyword;
      }

      // If on routes page
      if (searchInputRoutes) {
        searchInputRoutes.value = keyword;
        searchInputRoutes.dispatchEvent(new Event('input', { bubbles: true }));
        document.getElementById('cercador-rutes')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // If on acampada page
      if (searchInputCamps) {
        searchInputCamps.value = keyword;
        searchInputCamps.dispatchEvent(new Event('input', { bubbles: true }));
        searchInputCamps.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    // Clear filter banner action
    document.getElementById('btnClearMapFilter')?.addEventListener('click', () => {
      const activeBar = document.getElementById('mapActiveFilterBar');
      if (activeBar) activeBar.classList.add('hidden');

      const resetRoutesBtn = document.getElementById('resetFilters') as HTMLButtonElement | null;
      if (resetRoutesBtn) resetRoutesBtn.click();

      const sCamps = document.getElementById('searchAcampada') as HTMLInputElement | null;
      if (sCamps) {
        sCamps.value = '';
        sCamps.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });

    // Add Route markers
    routesData.forEach((r: any) => {
      if (!r.lat || !r.lon) return;

      const popupContent = `
        <div style="font-family: inherit; font-size: 12px; max-width: 250px; padding: 2px;">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px; margin-bottom: 4px;">
            <span style="background: #1b4332; color: white; padding: 2px 6px; border-radius: 4px; font-weight: bold; font-size: 10px;">RUTA</span>
            <span style="color: #666; font-size: 11px;">${r.municipi} (${r.illa || 'Mallorca'})</span>
          </div>
          <strong style="font-size: 13px; line-height: 1.3; color: #1c1917; display: block; margin-bottom: 6px;">
            ${r.nom}
          </strong>
          <div style="background: #f5f5f4; padding: 4px 6px; border-radius: 6px; margin-bottom: 6px; display: flex; justify-content: space-between; font-weight: 600; color: #44403c;">
            <span>🥾 ${r.distancia_km} km</span>
            <span>⛰️ +${r.desnivell_positiu_m}m</span>
            <span>${r.dificultat}</span>
          </div>
          <div style="display: flex; gap: 4px; margin-top: 6px;">
            <button
              type="button"
              onclick="window.__filterMallorca('${r.municipi.replace(/'/g, "\\'")}')"
              style="flex: 1; text-align: center; background: #e7e5e4; color: #1c1917; padding: 5px 6px; border-radius: 6px; border: none; font-weight: 600; cursor: pointer; font-size: 11px;"
              title="Filtra la llista per aquest municipi"
            >
              🔍 Filtra ${r.municipi}
            </button>
            <a href="/rutes/${r.slug}" style="flex: 1; text-align: center; background: #1b4332; color: white; padding: 5px 6px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 11px;">
              Fitxa →
            </a>
          </div>
        </div>
      `;

      const marker = L.marker([r.lat, r.lon], { icon: routeIcon }).bindPopup(popupContent);
      marker._illa = (r.illa || 'Mallorca').toLowerCase().trim();
      marker._type = 'ruta';
      routeMarkers.push(marker);
    });

    // Add Campsite markers
    acampadesData.forEach((a: any) => {
      if (!a.lat || !a.lon) return;

      const popupContent = `
        <div style="font-family: inherit; font-size: 12px; max-width: 250px; padding: 2px;">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 4px; margin-bottom: 4px;">
            <span style="background: #d97706; color: white; padding: 2px 6px; border-radius: 4px; font-weight: bold; font-size: 10px;">ACAMPADA / REFUGI</span>
            <span style="color: #666; font-size: 11px;">${a.municipi} (${a.illa || 'Mallorca'})</span>
          </div>
          <strong style="font-size: 13px; line-height: 1.3; color: #1c1917; display: block; margin-bottom: 6px;">
            ${a.nom}
          </strong>
          <div style="background: #fef3c7; color: #92400e; padding: 4px 6px; border-radius: 6px; margin-bottom: 6px; font-weight: 600; font-size: 11px;">
            Titularitat: ${a.titularitat}
            ${a.capacitat ? `<br>Capacitat: ${a.capacitat}` : ''}
          </div>
          <div style="display: flex; gap: 4px; margin-top: 6px;">
            <button
              type="button"
              onclick="window.__filterMallorca('${a.municipi.replace(/'/g, "\\'")}')"
              style="flex: 1; text-align: center; background: #e7e5e4; color: #1c1917; padding: 5px 6px; border-radius: 6px; border: none; font-weight: 600; cursor: pointer; font-size: 11px;"
              title="Filtra la llista per aquest municipi"
            >
              🔍 Filtra ${a.municipi}
            </button>
            ${a.web ? `
              <a href="${a.web}" target="_blank" rel="noopener noreferrer" style="flex: 1; text-align: center; background: #d97706; color: white; padding: 5px 6px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 11px;">
                Reserva ↗
              </a>
            ` : `
              <a href="/acampada" style="flex: 1; text-align: center; background: #57534e; color: white; padding: 5px 6px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 11px;">
                Directori →
              </a>
            `}
          </div>
        </div>
      `;

      const marker = L.marker([a.lat, a.lon], { icon: acampadaIcon }).bindPopup(popupContent);
      marker._illa = (a.illa || 'Mallorca').toLowerCase().trim();
      marker._type = 'acampada';
      acampadaMarkers.push(marker);
    });

    // Expose global callback for HTML popup buttons
    (window as any).__filterMallorca = (name: string) => {
      triggerFilterFromMap(name, 'municipi');
    };
    (window as any).__filterMap = (name: string) => {
      triggerFilterFromMap(name, 'municipi');
    };

    let currentIsland = 'all';
    let currentLayerFilter = initialType;

    function updateMarkerVisibility() {
      routeMarkers.forEach((marker: any) => {
        const matchType = currentLayerFilter === 'all' || currentLayerFilter === 'rutes';
        const matchIsland = currentIsland === 'all' || marker._illa === currentIsland;
        if (matchType && matchIsland) {
          if (!map.hasLayer(marker)) map.addLayer(marker);
        } else {
          if (map.hasLayer(marker)) map.removeLayer(marker);
        }
      });

      acampadaMarkers.forEach((marker: any) => {
        const matchType = currentLayerFilter === 'all' || currentLayerFilter === 'acampada';
        const matchIsland = currentIsland === 'all' || marker._illa === currentIsland;
        if (matchType && matchIsland) {
          if (!map.hasLayer(marker)) map.addLayer(marker);
        } else {
          if (map.hasLayer(marker)) map.removeLayer(marker);
        }
      });
    }

    // Expose window.__setMapIsland globally
    (window as any).__setMapIsland = function(island: string) {
      const raw = (island || '').toLowerCase().trim();
      const target = (raw === '' || raw === 'all' || raw === 'totes') ? 'all' : raw;
      currentIsland = target;

      if (target === 'all') {
        if (map.flyTo) {
          map.flyTo(archipelagoCenter, archipelagoZoom);
        } else {
          map.setView(archipelagoCenter, archipelagoZoom);
        }
      } else {
        const conf = islandsConfig[target];
        if (conf) {
          if (conf.bounds) {
            if (map.flyToBounds) {
              map.flyToBounds(conf.bounds, { padding: [30, 30], maxZoom: 12 });
            } else {
              map.fitBounds(conf.bounds, { padding: [30, 30], maxZoom: 12 });
            }
          } else if (conf.center) {
            if (map.flyTo) {
              map.flyTo(conf.center, conf.zoom);
            } else {
              map.setView(conf.center, conf.zoom);
            }
          }
        }
      }

      updateMarkerVisibility();
    };

    // Initial layer state
    function applyLayerFilter(filterType: string) {
      currentLayerFilter = filterType;
      updateMarkerVisibility();

      // Update button styling
      const buttons = document.querySelectorAll('.map-filter-btn');
      buttons.forEach((btn) => {
        const b = btn as HTMLButtonElement;
        const isActive = b.dataset.filter === filterType;
        if (isActive) {
          b.className = 'map-filter-btn px-3 py-1.5 rounded-lg transition bg-white text-stone-900 shadow-xs font-bold';
        } else {
          b.className = 'map-filter-btn px-3 py-1.5 rounded-lg transition text-stone-600 hover:text-stone-900 font-medium';
        }
      });
    }

    applyLayerFilter(initialType);

    // If there was a pending island call before map initialized, execute it now
    if (pendingMapIsland) {
      (window as any).__setMapIsland(pendingMapIsland);
      pendingMapIsland = null;
    } else {
      // Check if URL query parameter ?illa=... is set
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const urlIlla = urlParams.get('illa');
        if (urlIlla) {
          (window as any).__setMapIsland(urlIlla);
        }
      } catch (e) {}
    }

    // Button event listeners
    const buttons = document.querySelectorAll('.map-filter-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const filterVal = target.dataset.filter || 'all';
        applyLayerFilter(filterVal);
      });
    });

    // Reset zoom button
    const btnReset = document.getElementById('btnResetMapZoom');
    btnReset?.addEventListener('click', () => {
      (window as any).__setMapIsland('all');
      if ((window as any).__setFilterIsland) {
        (window as any).__setFilterIsland('all');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupOsmMap);
  setTimeout(setupOsmMap, 300);
</script>
